*.cdt
*.CDR
*.IDT
*.IDR
*.KDR
*.NDR
*.TDT
*.TDR
*.BDT
*.BDR
*.LDT
*.SD1
*.SD2
*.SPR

# Scratch output from checks
/shots/
*.pdf

# Editor and OS clutter
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local Flatpak builds
/build-flatpak/
/.flatpak-builder/
/repo-flatpak/
